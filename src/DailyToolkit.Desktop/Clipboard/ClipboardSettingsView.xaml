<UserControl x:Class="DailyToolkit.Desktop.ClipRecall.ClipboardSettingsView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:controls="clr-namespace:DailyToolkit.Desktop.Controls">
 <UserControl.Resources>
  <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}"><Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
   <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/><Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="8,6"/></Style>
  <Style TargetType="CheckBox"><Setter Property="Foreground" Value="{DynamicResource TextBrush}"/></Style>
 </UserControl.Resources>
 <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
  <StackPanel Margin="0,0,8,0" IsEnabled="{Binding IsLoaded}">
   <Border Style="{StaticResource Card}" Margin="0,0,0,12"><StackPanel>
    <TextBlock Text="剪贴回溯" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,12"/>
    <TextBlock Text="开启后自动记录剪贴板。" Style="{StaticResource MutedText}"/>
    <TextBlock Text="{Binding Status}" Foreground="{DynamicResource AccentBrush}" Margin="0,8,0,0"/>
    <Grid Margin="0,16,0,12"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
     <TextBlock Text="呼出 / 关闭" VerticalAlignment="Center" FontWeight="SemiBold"/>
     <TextBox Grid.Column="1" IsReadOnly="True" Text="{Binding ShortcutText, Mode=OneWay}" PreviewKeyDown="CaptureShortcut" GotKeyboardFocus="ShortcutFocus" LostKeyboardFocus="ShortcutBlur" Margin="12,0,6,0" ToolTip="按下新的快捷键；Esc 取消。" AutomationProperties.Name="剪贴回溯全局快捷键"/>
     <Button Grid.Column="2" Content="清空" Click="ClearShortcut" Padding="8,6"/>
    </Grid>
    <Button Content="恢复默认快捷键" Click="ResetShortcut" HorizontalAlignment="Left"/>
    <CheckBox Content="恢复的内容允许进入 Windows 剪贴板历史（Win+V）" IsChecked="{Binding IncludeRestoredInWindowsHistory}" Margin="0,16,0,0"/>
    <TextBlock Text="默认关闭，是否收录由 Windows 设置和内容类型决定。重新复制时不允许云剪贴板同步。" Style="{StaticResource MutedText}" Margin="0,8,0,0"/>
   </StackPanel></Border>
   <Border Style="{StaticResource Card}" Margin="0,0,0,12"><StackPanel>
    <TextBlock Text="历史面板配色" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,12"/>
    <TextBlock Text="不随软件主题改变。选好颜色后，点击“保存配色”。" Style="{StaticResource MutedText}" Margin="0,0,0,12"/>
    <ItemsControl ItemsSource="{Binding AppearancePresets}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
     <ItemsControl.ItemTemplate><DataTemplate><Button Content="{Binding Name}" Margin="0,0,8,8" Padding="10,6"
      Command="{Binding DataContext.SelectAppearancePresetCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}">
      <Button.Style><Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Style.Triggers><DataTrigger Binding="{Binding IsSelected}" Value="True"><Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/></DataTrigger></Style.Triggers></Style></Button.Style>
     </Button></DataTemplate></ItemsControl.ItemTemplate>
    </ItemsControl>
    <Border x:Name="PalettePreview" CornerRadius="10" Padding="14" BorderThickness="1" Background="{DynamicResource WindowBrush}" BorderBrush="{DynamicResource BorderBrush}" Margin="0,6,0,12">
     <StackPanel><TextBlock Text="剪贴回溯" FontSize="17" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}"/>
      <Border Background="{DynamicResource AccentSoftBrush}" CornerRadius="8" Padding="12" Margin="0,10,0,0"><StackPanel>
       <TextBlock Text="周末采购清单" Foreground="{DynamicResource TextBrush}"/><TextBlock Text="复制时间 · 永久保存 · 备注" Foreground="{DynamicResource MutedBrush}" FontSize="12" Margin="0,4,0,0"/>
      </StackPanel></Border>
      <Button Content="重新复制" IsHitTestVisible="False" Focusable="False" Style="{StaticResource AccentButton}" HorizontalAlignment="Left" Padding="12,6" Margin="0,10,0,0"/>
     </StackPanel>
    </Border>
    <WrapPanel><Button Content="保存配色" Command="{Binding SaveAppearanceCommand}" Margin="0,0,8,8"/><Button Content="撤销修改" Command="{Binding DiscardAppearanceCommand}" Margin="0,0,8,8"/><Button Content="恢复默认配色" Command="{Binding ResetAppearanceCommand}" Margin="0,0,0,8"/></WrapPanel>
    <Expander Header="自定义颜色" Foreground="{DynamicResource TextBrush}"><ItemsControl ItemsSource="{Binding AppearanceColors}" Margin="0,12,0,0">
     <ItemsControl.ItemTemplate><DataTemplate><Grid Margin="0,0,0,10"><Grid.ColumnDefinitions><ColumnDefinition Width="110"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <TextBlock Text="{Binding Name}" VerticalAlignment="Top" Margin="0,5,8,0"/><controls:ColorPicker Grid.Column="1" Color="{Binding Value, Mode=TwoWay}"/>
     </Grid></DataTemplate></ItemsControl.ItemTemplate>
    </ItemsControl></Expander>
   </StackPanel></Border>
   <Border Style="{StaticResource Card}" Margin="0,0,0,12"><StackPanel>
    <TextBlock Text="普通历史容量" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,12"/>
    <WrapPanel><StackPanel Margin="0,0,16,12"><TextBlock Text="最多条数"/><TextBox Text="{Binding MaximumRecords, UpdateSourceTrigger=LostFocus}" Width="100" Margin="0,6,0,0"/></StackPanel>
     <StackPanel Margin="0,0,16,12"><TextBlock Text="保留天数"/><TextBox Text="{Binding RetentionDays, UpdateSourceTrigger=LostFocus}" Width="100" Margin="0,6,0,0"/></StackPanel>
     <StackPanel Margin="0,0,16,12"><TextBlock Text="容量上限（MB）"/><TextBox Text="{Binding MaximumOrdinaryMegabytes, UpdateSourceTrigger=LostFocus}" Width="110" Margin="0,6,0,0"/></StackPanel>
     <StackPanel Margin="0,0,0,12"><TextBlock Text="单条上限（KB）"/><TextBox Text="{Binding MaximumTextKilobytes, UpdateSourceTrigger=LostFocus}" Width="110" Margin="0,6,0,0"/></StackPanel>
     <StackPanel Margin="16,0,0,12"><TextBlock Text="图片上限（MB）"/><TextBox Text="{Binding MaximumImageMegabytes, UpdateSourceTrigger=LostFocus}" Width="110" Margin="0,6,0,0"/></StackPanel>
    </WrapPanel>
    <TextBlock Text="永久保存项不会自动清理；只置顶的记录仍按普通规则清理。" Style="{StaticResource MutedText}"/>
   </StackPanel></Border>
   <Border Style="{StaticResource Card}" Margin="0,0,0,12"><StackPanel>
    <TextBlock Text="文件夹缓存" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,12"/>
    <DockPanel>
     <controls:FeatureSwitch x:Name="FileCacheSwitch" DockPanel.Dock="Right" IsOn="{Binding UseCachedFiles, Mode=TwoWay}"
       VerticalAlignment="Center" Margin="12,0,0,0" AutomationProperties.Name="自动缓存文件并从缓存复制"
       AnimationSpeed="{Binding DataContext.AnimationSpeed, RelativeSource={RelativeSource AncestorType=Window}, FallbackValue=1}"
       AnimationsEnabled="{Binding DataContext.PageAnimationsEnabled, RelativeSource={RelativeSource AncestorType=Window}, FallbackValue=True}"/>
     <TextBlock Text="自动缓存新复制的文件，并优先从缓存重新复制" VerticalAlignment="Center" TextWrapping="Wrap"/>
    </DockPanel>
    <TextBlock Text="关闭后使用原路径。开启后自动保存限制内的新文件副本，旧记录可手动缓存。原件删除后，成功缓存的文件仍可重新复制。" Style="{StaticResource MutedText}" Margin="0,8,0,12"/>
    <WrapPanel>
     <StackPanel Margin="0,0,16,12"><TextBlock Text="单条文件总大小（MB）"/><TextBox Text="{Binding MaximumCachedFileMegabytes, UpdateSourceTrigger=LostFocus}" Width="140" Margin="0,6,0,0"/></StackPanel>
     <StackPanel Margin="0,0,0,12"><TextBlock Text="文件缓存总限额（MB）"/><TextBox Text="{Binding MaximumFileCacheMegabytes, UpdateSourceTrigger=LostFocus}" Width="140" Margin="0,6,0,0"/></StackPanel>
    </WrapPanel>
    <TextBlock Text="缓存加密保存，重新复制时生成未加密临时副本。最后使用满 24 小时后，在软件运行且历史库打开时清理；临时副本也受总限额约束。关闭开关会保留已有缓存。" Style="{StaticResource MutedText}"/>
   </StackPanel></Border>
   <Border Style="{StaticResource Card}" Margin="0,0,0,12"><StackPanel>
    <TextBlock Text="隐私与排除应用" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,12"/>
    <CheckBox Content="暂停监听" IsChecked="{Binding IsPaused}" IsEnabled="{Binding IsEnabled}" Margin="0,0,0,12"/>
    <TextBlock Text="排除应用：每行一个进程名，如 KeePass.exe、1Password.exe。无法确定来源时不会匹配。" Style="{StaticResource MutedText}" Margin="0,0,0,8"/>
    <TextBox Text="{Binding ExcludedApplications, UpdateSourceTrigger=LostFocus}" AcceptsReturn="True" TextWrapping="Wrap" Height="90" VerticalScrollBarVisibility="Auto" MaxLength="10000" AutomationProperties.Name="排除应用列表"/>
    <TextBlock Text="无法自动识别所有密码或私人资料，复制前请暂停记录。来源明确禁止保存历史的内容会跳过。加密记录通常只能在原 Windows 用户和电脑上读取。" Style="{StaticResource MutedText}" Margin="0,10,0,0"/>
   </StackPanel></Border>
   <Border Style="{StaticResource Card}"><StackPanel>
    <TextBlock Text="数据管理" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,12"/>
    <TextBlock Text="{Binding StorageText}" Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,12"/>
    <WrapPanel><Button Content="历史记录" Click="OpenPanel" Margin="0,0,8,8"/><Button Content="永久保存记录" Click="OpenSaved" Margin="0,0,8,8"/><Button Content="清空普通历史" Click="ClearOrdinary" Margin="0,0,8,8"/><Button Content="清空全部历史" Click="ClearAll" Margin="0,0,0,8"/></WrapPanel>
    <WrapPanel><Button Content="打开数据目录" Click="OpenDirectory" Margin="0,0,8,8"/><Button Content="创建加密备份" Click="Backup" Margin="0,0,8,8"/><Button Content="恢复最近备份" Click="RestoreBackup" Margin="0,0,0,8"/></WrapPanel>
    <WrapPanel><Button Content="重试保存设置" Click="SaveSettings" Margin="0,0,8,8"/><Button Content="恢复默认设置" Click="ResetSettings" Margin="0,0,0,8"/></WrapPanel>
    <TextBlock Text="删除记录可在 12 秒内撤销；清空历史无法撤销，且会移除最近备份。恢复备份前请暂停监听。" Style="{StaticResource MutedText}"/>
   </StackPanel></Border>
   <TextBlock Text="{Binding Notice}" TextWrapping="Wrap" Foreground="{DynamicResource AccentBrush}" Margin="0,12,0,0"/>
  </StackPanel>
 </ScrollViewer>
</UserControl>
