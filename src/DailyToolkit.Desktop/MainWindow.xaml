<Window x:Class="DailyToolkit.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:DailyToolkit.Desktop.Controls"
        Title="DailyToolkit" Width="1040" Height="800" MinWidth="680" MinHeight="540"
        FontFamily="Microsoft YaHei UI" FontSize="14"
        Foreground="{DynamicResource TextBrush}" Background="{DynamicResource WindowBrush}"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="Auto"
        TextOptions.TextHintingMode="Fixed" WindowStartupLocation="CenterScreen">
  <Grid x:Name="RootContent" Background="{DynamicResource WindowBrush}" RenderOptions.ClearTypeHint="Enabled">
    <Grid.ColumnDefinitions><ColumnDefinition Width="188" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
    <Grid x:Name="SidebarSurface" ClipToBounds="True">
    <Border x:Name="SidebarBase" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,0">
      <Border.Style>
        <Style TargetType="Border">
          <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
          <Style.Triggers><DataTrigger Binding="{Binding IsFavorites}" Value="True"><Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" /></DataTrigger></Style.Triggers>
        </Style>
      </Border.Style>
      <DockPanel Margin="16,26,16,20">
        <StackPanel DockPanel.Dock="Top" Margin="10,0,0,30">
          <StackPanel Orientation="Horizontal">
            <Border Width="28" Height="28" CornerRadius="7" Background="{DynamicResource AccentBrush}">
              <TextBlock Text="D" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource AccentForegroundBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <TextBlock Text="DailyToolkit" Margin="9,0,0,0" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" />
          </StackPanel>
          <TextBlock Text="日常小工具" Style="{StaticResource MutedText}" Margin="0,13,0,0" />
        </StackPanel>
        <StackPanel DockPanel.Dock="Bottom" Margin="0,0,0,0">
          <Button x:Name="FavoritesButton" Click="OpenFavorites" HorizontalAlignment="Left" Padding="11,7"
                  FontSize="25" BorderThickness="0" Background="Transparent" Foreground="{DynamicResource AccentBrush}"
                  ToolTip="收藏夹" AutomationProperties.Name="打开收藏夹" Margin="0,0,0,16">
            <TextBlock Text="★" FontFamily="Segoe UI Symbol" FontSize="25" />
          </Button>
          <TextBlock Margin="0,8,0,0" FontSize="12">
            <Hyperlink NavigateUri="https://github.com/YMXKNebula/DailyToolkit" RequestNavigate="OpenRepository" Foreground="{DynamicResource MutedBrush}">DailyToolkit 0.4.0</Hyperlink>
          </TextBlock>
        </StackPanel>
        <DockPanel>
          <Button DockPanel.Dock="Top" Content="← 退出收藏夹" Click="ExitFavorites" Padding="10,10"
                  HorizontalContentAlignment="Left" BorderThickness="0" Background="Transparent" Margin="0,0,0,12"
                  Visibility="{Binding IsFavorites, Converter={StaticResource VisibleWhen}}" />
          <TextBlock DockPanel.Dock="Top" Text="拖动排序 · 右键也可调整" FontSize="11" Foreground="{DynamicResource MutedBrush}"
                     Margin="8,0,0,10" Visibility="{Binding ShowAllTools, Converter={StaticResource VisibleWhen}}" />
          <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <ItemsControl ItemsSource="{Binding NavigationItems}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <RadioButton GroupName="Navigation" Style="{StaticResource NavButton}" Padding="10,12"
                               IsChecked="{Binding IsSelected, Mode=OneWay}" CommandParameter="{Binding}"
                               Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                               Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=Window}}"
                               PreviewMouseLeftButtonDown="NavigationDragStart" PreviewMouseMove="NavigationDragMove"
                               AllowDrop="True" DragOver="NavigationDragOver" Drop="NavigationDrop" ToolTip="拖动调整顺序">
                    <RadioButton.ContextMenu>
                      <ContextMenu DataContext="{Binding PlacementTarget.Tag, RelativeSource={RelativeSource Self}}">
                        <MenuItem Header="上移" Command="{Binding MoveUpCommand}"
                                  CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                        <MenuItem Header="下移" Command="{Binding MoveDownCommand}"
                                  CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                      </ContextMenu>
                    </RadioButton.ContextMenu>
                    <StackPanel Orientation="Horizontal">
                      <TextBlock Text="{Binding Icon}" FontFamily="Segoe MDL2 Assets" FontSize="15" VerticalAlignment="Center" Margin="0,0,9,0" />
                      <TextBlock Text="{Binding Name}" FontSize="13" VerticalAlignment="Center" />
                    </StackPanel>
                  </RadioButton>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </DockPanel>
      </DockPanel>
    </Border>
    <Image x:Name="SidebarTransition" Visibility="Collapsed" IsHitTestVisible="False" Stretch="Fill" />
    </Grid>
    <Grid Grid.Column="1" Margin="{Binding ContentPadding}">
      <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
      <Grid Margin="0,0,0,20">
        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
        <StackPanel Margin="0,0,14,0">
          <TextBlock Text="{Binding PageTitle}" FontSize="26" FontWeight="SemiBold" />
          <TextBlock Text="{Binding PageDescription}" Style="{StaticResource MutedText}" Margin="0,8,0,0" />
        </StackPanel>
        <Button Grid.Column="1" Content="{Binding RefreshText}" Command="{Binding RefreshCommand}" VerticalAlignment="Top" Margin="0,5,0,0" />
      </Grid>

      <ScrollViewer x:Name="HomeScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                    Visibility="{Binding IsHome, Converter={StaticResource VisibleWhen}}">
        <StackPanel Margin="0,0,8,0">
          <UniformGrid Columns="2" Margin="-6,0,-6,6">
            <Border Style="{StaticResource Card}" MinHeight="152" Margin="6,0,6,12">
              <StackPanel>
                <TextBlock Text="日期与时间" Style="{StaticResource MutedText}" />
                <TextBlock Text="{Binding TimeText}" FontFamily="Segoe UI" FontSize="34" FontWeight="SemiBold" Margin="0,6,0,5" />
                <TextBlock Text="{Binding DateText}" FontSize="13" TextWrapping="Wrap" />
              </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}" MinHeight="152" Margin="6,0,6,12">
              <StackPanel>
                <TextBlock Text="天气" Style="{StaticResource MutedText}" />
                <TextBlock Text="{Binding WeatherText}" FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap"
                           TextTrimming="CharacterEllipsis" LineHeight="27" MaxHeight="54" Margin="0,8,0,7" ToolTip="{Binding WeatherText}" />
                <TextBlock Text="{Binding WeatherNote}" Style="{StaticResource MutedText}" />
                <TextBlock Text="{Binding WeatherUpdatedText}" Style="{StaticResource MutedText}" Margin="0,5,0,0" />
              </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}" MinHeight="152" Margin="6,0,6,12">
              <StackPanel>
                <TextBlock Text="网络" Style="{StaticResource MutedText}" />
                <TextBlock Text="{Binding NetworkText}" FontSize="22" FontWeight="SemiBold" Margin="0,8,0,5" />
                <TextBlock Text="{Binding NetworkDetail}" Style="{StaticResource MutedText}" />
                <TextBlock Text="{Binding TrafficText}" FontFamily="Segoe UI" FontSize="13" Margin="0,8,0,0"
                           TextWrapping="Wrap" ToolTip="有默认网关的活动网卡流量，不进行联网测速" />
              </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}" MinHeight="152" Margin="6,0,6,12">
              <StackPanel>
                <TextBlock Text="电源" Style="{StaticResource MutedText}" />
                <TextBlock Text="{Binding PowerText}" FontSize="20" FontWeight="SemiBold" Margin="0,8,0,7" TextWrapping="Wrap" />
                <TextBlock Text="{Binding PowerDetail}" Style="{StaticResource MutedText}" />
                <TextBlock Text="Windows 电源信息" Style="{StaticResource MutedText}" Margin="0,8,0,0" />
              </StackPanel>
            </Border>
          </UniformGrid>

          <Border Style="{StaticResource Card}" Margin="0,0,0,14">
            <StackPanel>
              <Grid Margin="0,0,0,16">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <TextBlock Text="这台电脑" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" />
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                  <Button Content="复制摘要" Click="CopySummary" Margin="0,0,8,0" Padding="10,7" />
                  <Button Content="保存报告" Click="SaveReport" Padding="10,7" />
                </StackPanel>
              </Grid>
              <ItemsControl ItemsSource="{Binding ComputerSummaryRows}" ItemTemplate="{StaticResource InformationRow}" />
              <Expander x:Name="HardwareExpander" Header="完整配置与运行环境" Foreground="{DynamicResource TextBrush}" Margin="0,8,0,0">
                <StackPanel Margin="0,18,0,0">
                  <ItemsControl ItemsSource="{Binding SystemRows}" ItemTemplate="{StaticResource InformationRow}" />
                  <TextBlock Text="显示设备" Style="{StaticResource SectionTitle}" Margin="0,10,0,12" />
                  <ItemsControl ItemsSource="{Binding GraphicsRows}" ItemTemplate="{StaticResource InformationRow}" />
                  <TextBlock Text="磁盘" Style="{StaticResource SectionTitle}" Margin="0,10,0,12" />
                  <ItemsControl ItemsSource="{Binding VolumeRows}" ItemTemplate="{StaticResource InformationRow}" />
                  <TextBlock Text="运行环境" Style="{StaticResource SectionTitle}" Margin="0,10,0,12" />
                  <DataGrid ItemsSource="{Binding RuntimeRows}" SelectionMode="Single" MaxHeight="200">
                    <DataGrid.Columns>
                      <DataGridTextColumn Header="环境" Binding="{Binding Name}" Width="*" />
                      <DataGridTextColumn Header="版本" Binding="{Binding Version}" Width="100" />
                      <DataGridTextColumn Header="状态" Binding="{Binding Status}" Width="70" />
                    </DataGrid.Columns>
                  </DataGrid>
                </StackPanel>
              </Expander>
            </StackPanel>
          </Border>
          <Border Style="{StaticResource Card}" Margin="0,0,0,14">
            <Expander x:Name="SoftwareExpander" Header="{Binding SoftwareHeader}" Foreground="{DynamicResource TextBrush}">
              <StackPanel Margin="0,16,0,0">
                <TextBlock Text="来自 Windows 安装记录，可能不包含便携软件。" Style="{StaticResource MutedText}" Margin="0,0,0,12" />
                <TextBox Text="{Binding SoftwareSearch, UpdateSourceTrigger=PropertyChanged}" Padding="10,8" Margin="0,0,0,12"
                         Background="{DynamicResource SurfaceBrush}" Foreground="{DynamicResource TextBrush}" BorderBrush="{DynamicResource BorderBrush}"
                         ToolTip="输入软件名称、版本或发布者筛选" AutomationProperties.Name="筛选已安装软件" />
                <DataGrid ItemsSource="{Binding SoftwareView}" Height="260" SelectionMode="Single">
                  <DataGrid.Columns>
                    <DataGridTextColumn Header="软件" Binding="{Binding Name}" Width="*" />
                    <DataGridTextColumn Header="版本" Binding="{Binding Version}" Width="90" />
                    <DataGridTextColumn Header="发布者" Binding="{Binding Publisher}" Width="110" />
                  </DataGrid.Columns>
                </DataGrid>
              </StackPanel>
            </Expander>
          </Border>
          <Border Background="{DynamicResource WarningBrush}" CornerRadius="8" Padding="14" Margin="0,0,0,14"
                  Visibility="{Binding HasIssues, Converter={StaticResource VisibleWhen}}">
            <TextBlock Text="{Binding IssueSummary}" TextWrapping="Wrap" Foreground="{DynamicResource WarningTextBrush}" FontSize="13" />
          </Border>
          <ProgressBar Height="2" IsIndeterminate="True" Foreground="{DynamicResource AccentBrush}"
                       Visibility="{Binding IsRefreshing, Converter={StaticResource VisibleWhen}}" />
        </StackPanel>
      </ScrollViewer>

      <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                    Visibility="{Binding ShowScreenLens, Converter={StaticResource VisibleWhen}}">
        <StackPanel DataContext="{Binding Gaming}" Margin="0,0,8,0">
          <Border Style="{StaticResource Card}">
            <StackPanel>
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Button Content="快捷键" Click="ToggleLensDetails" FontSize="13" FontWeight="SemiBold"
                        Padding="0,6" BorderThickness="0" Background="Transparent" ToolTip="展开或收起详细设置" />
                <TextBox Grid.Column="1" Text="{Binding ToggleShortcutText, Mode=OneWay}" IsReadOnly="True" Padding="8,6"
                         MinWidth="62" Margin="12,0,4,0" VerticalContentAlignment="Center"
                         PreviewKeyDown="CaptureShortcut" GotKeyboardFocus="ShortcutFocus" LostKeyboardFocus="ShortcutBlur"
                         Background="{DynamicResource SurfaceBrush}" Foreground="{DynamicResource TextBrush}" BorderBrush="{DynamicResource BorderBrush}"
                         ToolTip="点击后按下想用的组合键。清空后可在详细设置中用按钮控制。"
                         AutomationProperties.Name="开启或关闭放大框的快捷键" />
                <Button Grid.Column="2" Content="清空" Click="ClearShortcut" Padding="6,6" FontSize="12" />
              <StackPanel Grid.Column="3" Orientation="Horizontal" Margin="10,0,4,0">
                <RadioButton Content="按住" GroupName="LensMode" IsChecked="{Binding IsHoldMode}" Style="{StaticResource NavButton}"
                             Padding="8,7" FontSize="13" Margin="0,0,2,0" ToolTip="按住快捷键开启，松开组合键中的任意一键就关闭。" />
                <RadioButton Content="切换" GroupName="LensMode" IsChecked="{Binding IsToggleMode}" Style="{StaticResource NavButton}"
                             Padding="8,7" FontSize="13" Margin="0" ToolTip="按一次开启，再按同一个快捷键关闭并释放画面资源。" />
              </StackPanel>
                <Button Grid.Column="4" Command="{Binding ToggleFavoriteCommand}"
                        Padding="4,6" FontSize="17" BorderThickness="0" Background="Transparent"
                        Foreground="{DynamicResource AccentBrush}" ToolTip="{Binding FavoriteHint}" AutomationProperties.Name="{Binding FavoriteHint}">
                  <TextBlock Text="{Binding FavoriteSymbol}" FontFamily="Segoe UI Symbol" FontSize="17" />
                </Button>
                <Button x:Name="LensDetailsToggle" Grid.Column="5" Content="▾" Click="ToggleLensDetails" Padding="6,6"
                        FontSize="16" BorderThickness="0" Background="Transparent" ToolTip="展开或收起详细设置"
                        AutomationProperties.Name="屏幕局部放大的详细设置" />
              </Grid>
              <Border x:Name="LensDetailsPanel" Visibility="Collapsed">
                <StackPanel Margin="0,16,0,0">
                  <TextBlock Text="快捷键在后台也能用。点击按键框修改，按 Esc 取消。" Style="{StaticResource MutedText}" Margin="0,0,0,18" />
                  <Grid x:Name="LensSettingsGrid" SizeChanged="LensSettingsSizeChanged">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="260" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                  <StackPanel x:Name="LensSettingsControls">
                    <StackPanel IsEnabled="{Binding CanConfigure}">
                    <TextBlock Text="使用鼠标所在屏幕，支持跨屏拖动。" Style="{StaticResource MutedText}" Margin="0,0,0,8" />
                    <TextBlock Text="{Binding SelectedMonitor.Name}" Style="{StaticResource MutedText}" Margin="0,0,0,18" />
                    </StackPanel>
                    <TextBlock Text="位置" FontWeight="SemiBold" Margin="0,0,0,10" />
                    <WrapPanel Margin="0,0,0,18">
                      <RadioButton x:Name="LensFixedMode" Content="固定" GroupName="LensMovement" IsChecked="{Binding IsFixedMode, Mode=TwoWay}" Margin="0,0,18,0" />
                      <RadioButton x:Name="LensMovableMode" Content="可移动" GroupName="LensMovement" IsChecked="{Binding IsMovableMode, Mode=TwoWay}" />
                    </WrapPanel>
                    <Grid>
                      <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                      <TextBlock Text="放大倍率" FontWeight="SemiBold" />
                      <TextBlock Grid.Column="1" Text="{Binding ZoomText}" />
                    </Grid>
                    <Slider Minimum="1" Maximum="{Binding MaximumZoom}" TickFrequency="0.25" IsSnapToTickEnabled="True" Value="{Binding Zoom}" Margin="0,10,0,10" AutomationProperties.Name="放大倍率" />
                    <CheckBox x:Name="LensWheelZoom" Content="滚轮调节" IsChecked="{Binding WheelZoomEnabled, Mode=TwoWay}" Margin="0,0,0,18"
                              ToolTip="在放大框或预览图内用滚轮调节倍率。关闭后仍可使用上方滑块。" />
                    <TextBlock Text="框体颜色" FontWeight="SemiBold" Margin="0,0,0,10" />
                    <controls:LensColorPicker x:Name="LensFrameColor" Margin="0,0,0,18" />
                    <StackPanel IsEnabled="{Binding CanConfigure}">
                    <TextBlock Text="放大框大小" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding FrameSizeText}" Style="{StaticResource MutedText}" Margin="0,6,0,10" />
                    <Grid>
                      <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                      <TextBlock Text="宽度（像素）" VerticalAlignment="Center" />
                      <TextBox Grid.Column="1" Text="{Binding FrameWidth, StringFormat=F0}" Width="68" Padding="6,4"
                               LostFocus="CommitLensSize" PreviewKeyDown="LensSizeKeyDown"
                               GotKeyboardFocus="ShortcutFocus" LostKeyboardFocus="ShortcutBlur"
                               Background="{DynamicResource SurfaceBrush}" Foreground="{DynamicResource TextBrush}" BorderBrush="{DynamicResource BorderBrush}"
                               AutomationProperties.Name="输入放大框宽度" />
                    </Grid>
                    <Slider Minimum="160" Maximum="1600" TickFrequency="8" IsSnapToTickEnabled="True" Value="{Binding FrameWidth}" Margin="0,10,0,12" AutomationProperties.Name="放大框宽度" />
                    <Grid>
                      <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                      <TextBlock Text="高度（像素）" VerticalAlignment="Center" />
                      <TextBox Grid.Column="1" Text="{Binding FrameHeight, StringFormat=F0}" Width="68" Padding="6,4"
                               LostFocus="CommitLensSize" PreviewKeyDown="LensSizeKeyDown"
                               GotKeyboardFocus="ShortcutFocus" LostKeyboardFocus="ShortcutBlur"
                               Background="{DynamicResource SurfaceBrush}" Foreground="{DynamicResource TextBrush}" BorderBrush="{DynamicResource BorderBrush}"
                               AutomationProperties.Name="输入放大框高度" />
                    </Grid>
                    <Slider Minimum="120" Maximum="1200" TickFrequency="8" IsSnapToTickEnabled="True" Value="{Binding FrameHeight}" Margin="0,10,0,18" AutomationProperties.Name="放大框高度" />
                    </StackPanel>
                    <Grid Margin="0,0,0,18" IsEnabled="{Binding CanConfigure}">
                      <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                      <TextBlock Text="帧率" FontWeight="SemiBold" VerticalAlignment="Center" />
                      <ComboBox Grid.Column="1" ItemsSource="{Binding FrameRates}" DisplayMemberPath="Label" SelectedValuePath="Value"
                                SelectedValue="{Binding FrameRate}" Width="126" Padding="6" />
                    </Grid>
                    <TextBlock Text="{Binding MovementHint}" Style="{StaticResource MutedText}" Margin="0,0,0,14" />
                  </StackPanel>
                  <controls:LensPreview x:Name="LensPhotoPreview" Grid.Column="1" VerticalAlignment="Top" Margin="18,0,0,18" />
                  </Grid>
                  <WrapPanel>
                    <Button Content="{Binding ToggleText}" Command="{Binding ToggleCommand}" Margin="0,0,8,8" />
                  </WrapPanel>
                  <TextBlock Text="{Binding Status}" Foreground="{DynamicResource AccentBrush}" TextWrapping="Wrap" Margin="0,8,0,16" />
                  <TextBlock Text="按住：松手即关闭。切换：再按一次关闭。大小和帧率请在关闭后调整。" Style="{StaticResource MutedText}" Margin="0,0,0,10" />
                  <TextBlock Text="游戏建议用窗口或无边框模式。放大效果取决于原画面清晰度。" Style="{StaticResource MutedText}" />
                  <Separator Margin="0,18,0,14" />
                  <Button Content="恢复默认" Command="{Binding ResetDefaultsCommand}" HorizontalAlignment="Left"
                          ToolTip="关闭放大框，恢复默认画面、居中位置和固定模式；保留快捷键、按住／切换模式和收藏。" />
                </StackPanel>
              </Border>
            </StackPanel>
          </Border>
        </StackPanel>
      </ScrollViewer>

      <Border Grid.Row="1" Style="{StaticResource Card}" VerticalAlignment="Top"
              Visibility="{Binding ShowFavoritesEmpty, Converter={StaticResource VisibleWhen}}">
        <StackPanel>
          <TextBlock Text="还没有收藏" FontSize="18" FontWeight="SemiBold" />
          <TextBlock Text="点击工具旁的星标，把它放到这里。" Style="{StaticResource MutedText}" Margin="0,10,0,16" />
          <Button Content="查看全部工具" Click="ExitFavorites" HorizontalAlignment="Left" />
        </StackPanel>
      </Border>

      <StackPanel Grid.Row="2" Margin="0,16,0,0">
        <TextBlock Text="{Binding Notice}" Foreground="{DynamicResource AccentBrush}" FontSize="13" Margin="0,0,0,8"
                   Visibility="{Binding HasNotice, Converter={StaticResource VisibleWhen}}" />
        <Grid>
          <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
          <TextBlock Text="{Binding FooterStatusText}" Style="{StaticResource MutedText}" />
          <TextBlock Grid.Column="1" Text="{Binding FooterSourceText}" Style="{StaticResource MutedText}" Margin="12,0,0,0" />
        </Grid>
      </StackPanel>
    </Grid>
  </Grid>
</Window>
