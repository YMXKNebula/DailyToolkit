<UserControl x:Class="DailyToolkit.Desktop.Controls.LensColorPicker"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:DailyToolkit.Desktop.Controls">
  <StackPanel>
    <ItemsControl x:Name="Palette">
      <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
      <ItemsControl.ItemTemplate>
        <DataTemplate>
          <Button Tag="{Binding Color}" Background="{Binding Color}" Click="SelectSwatch"
                  Width="26" Height="26" Margin="0,0,6,6" Padding="0" ToolTip="{Binding Name}"
                  AutomationProperties.Name="{Binding Name}">
            <Button.Style>
              <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Style.Triggers>
                  <DataTrigger Binding="{Binding IsSelected}" Value="True">
                    <Setter Property="BorderBrush" Value="{DynamicResource TextBrush}" />
                    <Setter Property="BorderThickness" Value="3" />
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </Button.Style>
          </Button>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>
    <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
      <Button x:Name="CustomColorButton" Click="ChooseCustomColor" Padding="8,5" ToolTip="自选颜色" AutomationProperties.Name="自选框体颜色">
        <StackPanel Orientation="Horizontal">
          <controls:ColorWheelIcon Width="20" Height="20" Margin="0,0,7,0" />
          <TextBlock Text="自选颜色" FontSize="13" VerticalAlignment="Center" />
        </StackPanel>
      </Button>
      <TextBlock Text="{Binding BorderColor}" FontFamily="Consolas" Style="{StaticResource MutedText}"
                 VerticalAlignment="Center" Margin="10,0,0,0" />
    </StackPanel>
  </StackPanel>
</UserControl>
