<UserControl x:Class="DailyToolkit.Desktop.Controls.AppUpdateControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <StackPanel>
    <StackPanel Orientation="Horizontal">
      <Button Content="{Binding ActionText}" IsEnabled="{Binding CanUpdate}" Click="Update" />
      <Button Content="取消" Click="Cancel" Margin="10,0,0,0"
              Visibility="{Binding CanCancel, Converter={StaticResource VisibleWhen}}" />
      <Button Content="打开文件夹" Click="OpenDownload" Margin="10,0,0,0"
              Visibility="{Binding HasDownload, Converter={StaticResource VisibleWhen}}" />
    </StackPanel>
    <ProgressBar Minimum="0" Maximum="100" Value="{Binding Progress, Mode=OneWay}" IsIndeterminate="{Binding IsIndeterminate}"
                 Height="4" Margin="0,12,0,0" Foreground="{DynamicResource AccentBrush}" Background="{DynamicResource SurfaceBrush}"
                 Visibility="{Binding IsBusy, Converter={StaticResource VisibleWhen}}" />
    <TextBlock Text="{Binding Status}" Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,10,0,0"
               Visibility="{Binding HasStatus, Converter={StaticResource VisibleWhen}}" AutomationProperties.LiveSetting="Polite" />
  </StackPanel>
</UserControl>
