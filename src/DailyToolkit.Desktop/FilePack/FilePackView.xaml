<UserControl x:Class="DailyToolkit.Desktop.FilePack.FilePackView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 AllowDrop="True" PreviewDragEnter="FilesDragOver" PreviewDragOver="FilesDragOver" PreviewDrop="FilesDropped"
 Foreground="{DynamicResource TextBrush}">
 <UserControl.Resources>
  <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
   <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/><Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
   <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="8,6"/>
  </Style>
  <Style TargetType="CheckBox"><Setter Property="Foreground" Value="{DynamicResource TextBrush}"/></Style>
  <Style x:Key="SmallButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
   <Setter Property="Padding" Value="10,6"/><Setter Property="Margin" Value="0,0,6,6"/>
  </Style>
  <Style TargetType="DataGrid">
   <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/><Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
   <Setter Property="RowBackground" Value="{DynamicResource SurfaceBrush}"/><Setter Property="AlternatingRowBackground" Value="{DynamicResource WindowBrush}"/>
   <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/><Setter Property="BorderThickness" Value="1"/>
   <Setter Property="HorizontalGridLinesBrush" Value="{DynamicResource BorderBrush}"/><Setter Property="GridLinesVisibility" Value="Horizontal"/>
   <Setter Property="HeadersVisibility" Value="Column"/><Setter Property="AutoGenerateColumns" Value="False"/>
   <Setter Property="CanUserAddRows" Value="False"/><Setter Property="CanUserDeleteRows" Value="False"/>
   <Setter Property="EnableRowVirtualization" Value="True"/><Setter Property="EnableColumnVirtualization" Value="True"/>
   <Setter Property="VirtualizingPanel.VirtualizationMode" Value="Recycling"/>
   <Setter Property="RowHeight" Value="40"/>
  </Style>
  <Style TargetType="DataGridColumnHeader">
   <Setter Property="Background" Value="{DynamicResource WindowBrush}"/><Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/>
   <Setter Property="Padding" Value="8"/><Setter Property="FontSize" Value="12"/><Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
  </Style>
  <Style TargetType="DataGridCell">
   <Setter Property="BorderThickness" Value="0"/><Setter Property="VerticalContentAlignment" Value="Center"/>
   <Setter Property="Padding" Value="6,4"/>
   <Style.Triggers><Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="{DynamicResource AccentSoftBrush}"/>
    <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/></Trigger></Style.Triggers>
  </Style>
  <Style x:Key="RowText" TargetType="TextBlock"><Setter Property="VerticalAlignment" Value="Center"/><Setter Property="Margin" Value="6,0"/>
   <Setter Property="TextTrimming" Value="CharacterEllipsis"/></Style>
 </UserControl.Resources>
 <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
  <StackPanel Margin="0,0,8,0">
   <Grid x:Name="WorkbenchLayout" SizeChanged="WorkbenchSizeChanged">
    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="0"/></Grid.ColumnDefinitions>
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Border x:Name="CollectionCard" Style="{StaticResource Card}">
     <StackPanel>
      <Grid Margin="0,0,0,12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
       <TextBlock Text="文件收集" FontSize="16" FontWeight="SemiBold"/>
       <TextBlock Grid.Column="1" Text="{Binding DraftSummary}" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center"/>
      </Grid>
      <WrapPanel IsEnabled="{Binding CanEditDraft}">
       <Button Content="添加文件" Command="{Binding AddFilesCommand}" Style="{StaticResource SmallButton}"/>
       <Button Content="添加文件夹" Command="{Binding AddFoldersCommand}" Style="{StaticResource SmallButton}"/>
       <Button Content="移除所选" Command="{Binding RemoveSelectedCommand}" CommandParameter="{Binding SelectedItems, ElementName=EntriesGrid}" Style="{StaticResource SmallButton}"/>
       <Button Content="检查重复" Command="{Binding CheckDuplicatesCommand}" Style="{StaticResource SmallButton}"/>
       <Button Content="清空" Command="{Binding ClearCommand}" Style="{StaticResource SmallButton}"/>
      </WrapPanel>
      <Grid Margin="0,2,0,10"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
       <TextBlock x:Name="DropHint" Text="拖入文件或文件夹" Style="{StaticResource MutedText}" VerticalAlignment="Center"/>
       <Button Grid.Column="1" Content="取消收集" Command="{Binding CancelCollectionCommand}" Style="{StaticResource SmallButton}"
        Visibility="{Binding IsCollecting, Converter={StaticResource VisibleWhen}}"/>
      </Grid>
      <DataGrid x:Name="EntriesGrid" ItemsSource="{Binding Entries}" SelectionMode="Extended" SelectionUnit="FullRow"
       IsEnabled="{Binding CanEditDraft}" Height="280" MinHeight="140" PreviewKeyDown="EntriesKeyDown" AutomationProperties.Name="待打包文件">
       <DataGrid.Columns>
        <DataGridTemplateColumn Header="名称" Width="130" IsReadOnly="True"><DataGridTemplateColumn.CellTemplate><DataTemplate>
         <TextBlock Text="{Binding Name}" ToolTip="{Binding Kind}" Style="{StaticResource RowText}"/>
        </DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
        <DataGridTemplateColumn Header="包内路径" Width="230"><DataGridTemplateColumn.CellTemplate><DataTemplate>
         <TextBox Text="{Binding PathDraft, UpdateSourceTrigger=PropertyChanged}" Padding="5,4" Margin="3" LostKeyboardFocus="PathEditingEnded"
          PreviewKeyDown="PathKeyDown" AutomationProperties.Name="包内路径" ToolTip="{Binding ArchivePath}"/>
        </DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
        <DataGridTemplateColumn Header="大小" Width="85" IsReadOnly="True"><DataGridTemplateColumn.CellTemplate><DataTemplate>
         <TextBlock Text="{Binding SizeText}" Style="{StaticResource RowText}"/>
        </DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
        <DataGridTemplateColumn Header="原始路径" Width="260" IsReadOnly="True"><DataGridTemplateColumn.CellTemplate><DataTemplate>
         <TextBlock Text="{Binding SourcePath}" ToolTip="{Binding SourcePath}" Style="{StaticResource RowText}"/>
        </DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
       </DataGrid.Columns>
      </DataGrid>
      <Expander Header="整理包内文件夹" Foreground="{DynamicResource TextBrush}" Margin="0,12,0,10" IsEnabled="{Binding CanEditDraft}">
       <StackPanel Margin="0,10,0,0">
        <Grid Margin="0,0,0,8"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
         <TextBox Text="{Binding NewFolderPath, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="新包内文件夹路径"/>
         <Button Grid.Column="1" Content="新建包内文件夹" Command="{Binding AddVirtualFolderCommand}" Margin="8,0,0,0" Padding="10,6"/>
        </Grid>
        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
         <TextBox Text="{Binding MoveTargetPath, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="包内目标文件夹" ToolTip="留空移到包根目录"/>
         <Button Grid.Column="1" Content="移动所选" Command="{Binding MoveSelectedCommand}" CommandParameter="{Binding SelectedItems, ElementName=EntriesGrid}" Margin="8,0,0,0" Padding="10,6"/>
        </Grid>
       </StackPanel>
      </Expander>
      <StackPanel IsEnabled="{Binding CanEditDraft}">
       <Grid Margin="0,0,0,12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="150"/></Grid.ColumnDefinitions>
        <StackPanel Margin="0,0,12,0"><TextBlock Text="任务名称" Margin="0,0,0,6"/><TextBox Text="{Binding TaskName, UpdateSourceTrigger=PropertyChanged}" MaxLength="200"/></StackPanel>
        <StackPanel Grid.Column="1"><TextBlock Text="打包方式" Margin="0,0,0,6"/>
         <ComboBox ItemsSource="{Binding Modes}" DisplayMemberPath="Name" SelectedValuePath="Value" SelectedValue="{Binding Mode}" AutomationProperties.Name="打包方式"/>
        </StackPanel>
       </Grid>
       <StackPanel Visibility="{Binding IsBuiltIn, Converter={StaticResource VisibleWhen}}">
        <Grid Margin="0,0,0,12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="110"/><ColumnDefinition Width="120"/></Grid.ColumnDefinitions>
         <StackPanel Margin="0,0,12,0"><TextBlock Text="压缩包名称" Margin="0,0,0,6"/><TextBox Text="{Binding ArchiveName, UpdateSourceTrigger=PropertyChanged}" MaxLength="220" ToolTip="默认按压缩完成时间命名，精确到分钟；可改为其他名称。"/></StackPanel>
         <StackPanel Grid.Column="1" Margin="0,0,12,0"><TextBlock Text="格式" Margin="0,0,0,6"/>
          <ComboBox ItemsSource="{Binding Formats}" DisplayMemberPath="Name" SelectedValuePath="Value" SelectedValue="{Binding Format}" AutomationProperties.Name="压缩格式"/>
         </StackPanel>
         <StackPanel Grid.Column="2"><TextBlock Text="压缩等级" Margin="0,0,0,6"/>
          <ComboBox ItemsSource="{Binding CompressionLevels}" DisplayMemberPath="Name" SelectedValuePath="Value" SelectedValue="{Binding Compression}"
           IsEnabled="{Binding CanChooseCompression}" AutomationProperties.Name="压缩等级"/>
         </StackPanel>
        </Grid>
        <TextBlock Text="保存文件夹" Margin="0,0,0,6"/>
        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
         <TextBox Text="{Binding OutputDirectory, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="压缩包保存文件夹"/>
         <Button Grid.Column="1" Content="选择" Command="{Binding BrowseOutputCommand}" Margin="8,0,0,0" Padding="10,6"/>
        </Grid>
        <TextBlock Text="{Binding OutputPreview}" TextTrimming="CharacterEllipsis" ToolTip="{Binding OutputPreview}" Foreground="{DynamicResource MutedBrush}" FontSize="12" Margin="0,6,0,10"/>
        <CheckBox Content="每次询问保存位置" IsChecked="{Binding AskOutputEachTime}" Margin="0,0,0,12"/>
       </StackPanel>
       <StackPanel Visibility="{Binding IsExternal, Converter={StaticResource VisibleWhen}}" Margin="0,0,0,12">
        <TextBlock Text="打开工作区后，使用自己的压缩软件打包。" Style="{StaticResource MutedText}" Margin="0,0,0,10"/>
        <CheckBox Content="默认保留外部工作区" IsChecked="{Binding KeepExternalWorkspace}"/>
       </StackPanel>
       <Button Content="{Binding CreateButtonText}" Command="{Binding CreateTaskCommand}" Style="{StaticResource AccentButton}" HorizontalAlignment="Left"/>
      </StackPanel>
     </StackPanel>
    </Border>
    <Border x:Name="TasksCard" Grid.Row="1" Style="{StaticResource Card}" Margin="0,12,0,0">
     <StackPanel>
      <Grid Margin="0,0,0,10"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="65"/></Grid.ColumnDefinitions>
       <TextBlock Text="打包任务" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"/>
       <TextBlock Grid.Column="1" Text="并行" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="{DynamicResource MutedBrush}"/>
       <ComboBox Grid.Column="2" ItemsSource="{Binding ParallelChoices}" SelectedItem="{Binding MaximumParallel}" IsEnabled="{Binding IsLoaded}" Padding="7,5" AutomationProperties.Name="最多同时压缩任务数"/>
      </Grid>
      <TextBlock Text="{Binding TaskSummary}" Style="{StaticResource MutedText}" Margin="0,0,0,12"/>
      <Grid>
       <ListBox x:Name="TasksList" ItemsSource="{Binding Tasks}" Height="480" BorderThickness="0" Background="Transparent" Foreground="{DynamicResource TextBrush}"
        ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto"
        VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" ScrollViewer.CanContentScroll="True"
        HorizontalContentAlignment="Stretch" AutomationProperties.Name="打包任务列表">
        <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="HorizontalContentAlignment" Value="Stretch"/>
         <Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="0,0,0,10"/>
         <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><ContentPresenter/></ControlTemplate></Setter.Value></Setter>
        </Style></ListBox.ItemContainerStyle>
        <ListBox.ItemTemplate><DataTemplate>
         <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="12" Background="{DynamicResource WindowBrush}">
          <StackPanel>
           <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}"/>
            <TextBlock Grid.Column="1" Text="{Binding StateText}" Foreground="{DynamicResource AccentBrush}" Margin="8,0,0,0"/>
           </Grid>
           <TextBlock Text="{Binding ConfigurationText}" FontSize="12" Foreground="{DynamicResource MutedBrush}" Margin="0,5,0,6"/>
           <ProgressBar Value="{Binding Percent, Mode=OneWay}" Maximum="100" Height="5" Foreground="{DynamicResource AccentBrush}" Background="{DynamicResource AccentSoftBrush}" BorderThickness="0"/>
           <TextBlock Text="{Binding ProgressText}" FontSize="12" Foreground="{DynamicResource MutedBrush}" Margin="0,6,0,0"/>
           <TextBlock Text="{Binding Location}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Location}" FontSize="12" Foreground="{DynamicResource MutedBrush}" Margin="0,6,0,6"/>
           <TextBlock Text="{Binding Error}" Visibility="{Binding HasError, Converter={StaticResource VisibleWhen}}" TextWrapping="Wrap"
            Foreground="{DynamicResource WarningTextBrush}" Margin="0,0,0,10"/>
           <Expander Header="错误详情" Visibility="{Binding HasErrorDetails, Converter={StaticResource VisibleWhen}}"
            Foreground="{DynamicResource MutedBrush}" FontSize="12" Margin="0,0,0,10">
            <ScrollViewer MaxHeight="180" VerticalScrollBarVisibility="Auto">
             <TextBlock Text="{Binding ErrorDetails}" TextWrapping="Wrap" Foreground="{DynamicResource TextBrush}" Margin="0,8,0,0"/>
            </ScrollViewer>
           </Expander>
           <WrapPanel>
            <Button Content="取消" IsEnabled="{Binding CanCancel}" Visibility="{Binding CanCancel, Converter={StaticResource VisibleWhen}}" Style="{StaticResource SmallButton}"
             Command="{Binding DataContext.CancelTaskCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"/>
            <Button Content="重试" Visibility="{Binding CanRetry, Converter={StaticResource VisibleWhen}}" Style="{StaticResource SmallButton}"
             Command="{Binding DataContext.RetryTaskCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"/>
            <Button Content="提前" Visibility="{Binding IsQueued, Converter={StaticResource VisibleWhen}}" Style="{StaticResource SmallButton}"
             Command="{Binding DataContext.MoveUpCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"/>
            <Button Content="延后" Visibility="{Binding IsQueued, Converter={StaticResource VisibleWhen}}" Style="{StaticResource SmallButton}"
             Command="{Binding DataContext.MoveDownCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"/>
            <Button Content="打开位置" Visibility="{Binding CanOpen, Converter={StaticResource VisibleWhen}}" Style="{StaticResource SmallButton}"
             Command="{Binding DataContext.OpenTaskCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"/>
            <Button Content="{Binding CompleteLabel}" Visibility="{Binding IsExternalReady, Converter={StaticResource VisibleWhen}}" Style="{StaticResource SmallButton}"
             Command="{Binding DataContext.CompleteExternalCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"/>
            <Button Content="{Binding AlternativeCompleteLabel}" Visibility="{Binding IsExternalReady, Converter={StaticResource VisibleWhen}}" Style="{StaticResource SmallButton}"
             Command="{Binding DataContext.KeepExternalCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"/>
            <Button Content="清理临时文件" Visibility="{Binding CanCleanup, Converter={StaticResource VisibleWhen}}" Style="{StaticResource SmallButton}"
             Command="{Binding DataContext.CleanupTaskCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"/>
            <Button Content="移除记录" Visibility="{Binding CanRemove, Converter={StaticResource VisibleWhen}}" Style="{StaticResource SmallButton}"
             Command="{Binding DataContext.RemoveTaskCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"/>
           </WrapPanel>
           <Expander Header="文件清单" Foreground="{DynamicResource MutedBrush}" FontSize="12" Margin="0,2,0,0">
            <DataGrid ItemsSource="{Binding Info.Snapshot.Entries}" IsReadOnly="True" Height="160" Margin="0,8,0,0" RowHeight="30" SelectionMode="Single">
             <DataGrid.Columns><DataGridTextColumn Header="包内路径" Binding="{Binding ArchivePath}" Width="*"/>
              <DataGridTextColumn Header="原始路径" Binding="{Binding SourcePath}" Width="*"/></DataGrid.Columns>
            </DataGrid>
           </Expander>
          </StackPanel>
         </Border>
        </DataTemplate></ListBox.ItemTemplate>
       </ListBox>
       <TextBlock Text="还没有打包任务" Foreground="{DynamicResource MutedBrush}" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,32,0,0" IsHitTestVisible="False">
        <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers>
         <DataTrigger Binding="{Binding Tasks.Count}" Value="0"><Setter Property="Visibility" Value="Visible"/></DataTrigger>
        </Style.Triggers></Style></TextBlock.Style>
       </TextBlock>
      </Grid>
     </StackPanel>
    </Border>
   </Grid>
   <TextBlock Text="{Binding Notice}" Visibility="{Binding HasNotice, Converter={StaticResource VisibleWhen}}" Foreground="{DynamicResource AccentBrush}" TextWrapping="Wrap" Margin="0,12,0,0"/>
  </StackPanel>
 </ScrollViewer>
</UserControl>
