<UserControl x:Class="DailyToolkit.Desktop.Notes.NotesSettingsView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:controls="clr-namespace:DailyToolkit.Desktop.Controls">
 <UserControl.Resources>
  <Style TargetType="CheckBox"><Setter Property="Foreground" Value="{DynamicResource TextBrush}"/></Style>
  <Style TargetType="RadioButton"><Setter Property="Foreground" Value="{DynamicResource TextBrush}"/></Style>
  <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
   <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
   <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
   <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
   <Setter Property="BorderThickness" Value="1"/>
  </Style>
 </UserControl.Resources>
 <Grid x:Name="SettingsLayout" SizeChanged="SettingsSizeChanged" IsEnabled="{Binding IsLoaded}">
  <ScrollViewer x:Name="SettingsScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
   <StackPanel Margin="0,0,8,0">
    <Border Style="{StaticResource Card}" Margin="0,0,0,12"><StackPanel>
     <Grid>
      <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <Grid.RowDefinitions><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
      <TextBlock Text="显示 / 隐藏" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"/>
      <TextBox Grid.Column="1" Tag="toggle" Text="{Binding ToggleShortcutText, Mode=OneWay}" IsReadOnly="True" Margin="12,0,4,8" Padding="8,6" MinWidth="62" VerticalContentAlignment="Center"
       PreviewKeyDown="CaptureShortcut" GotKeyboardFocus="ShortcutFocus" LostKeyboardFocus="ShortcutBlur" ToolTip="按下新的快捷键；Esc 取消。" AutomationProperties.Name="浮笺显示隐藏快捷键"/>
      <Button Grid.Column="2" Tag="toggle" Content="清空" Click="ClearShortcut" Padding="6,6" FontSize="12" Margin="0,0,0,8"/>
      <TextBlock Grid.Row="1" Text="聚焦" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"/>
      <TextBox Grid.Row="1" Grid.Column="1" Tag="focus" Text="{Binding FocusShortcutText, Mode=OneWay}" IsReadOnly="True" Margin="12,0,4,0" Padding="8,6" MinWidth="62" VerticalContentAlignment="Center"
       PreviewKeyDown="CaptureShortcut" GotKeyboardFocus="ShortcutFocus" LostKeyboardFocus="ShortcutBlur" ToolTip="按一次聚焦，按一次取消聚焦；不会显示已隐藏的浮笺。" AutomationProperties.Name="浮笺聚焦快捷键"/>
      <Button Grid.Row="1" Grid.Column="2" Tag="focus" Content="清空" Click="ClearShortcut" Padding="6,6" FontSize="12"/>
     </Grid>
     <Button Content="恢复默认快捷键" Click="ResetShortcuts" HorizontalAlignment="Left" Margin="0,12,0,12"/>
     <WrapPanel><Button Content="显示 / 隐藏浮笺" Click="ToggleNote" IsEnabled="{Binding IsEnabled}" Margin="0,0,8,8"/>
     </WrapPanel>
     <TextBlock Text="{Binding Status}" Foreground="{DynamicResource MutedBrush}"/>
    </StackPanel></Border>
    <Border Style="{StaticResource Card}" Margin="0,0,0,12"><StackPanel>
     <TextBlock Text="位置" FontWeight="SemiBold" Margin="0,0,0,10"/>
     <WrapPanel Margin="0,0,0,12">
      <RadioButton x:Name="NotesFixedMode" Content="固定" GroupName="NotesMovement" IsChecked="{Binding IsFixedMode, Mode=TwoWay}" Margin="0,0,18,0"/>
      <RadioButton x:Name="NotesMovableMode" Content="可移动" GroupName="NotesMovement" IsChecked="{Binding IsMovableMode, Mode=TwoWay}"/>
     </WrapPanel>
     <TextBlock Text="可移动时，按住顶部即可拖动。" Style="{StaticResource MutedText}" Margin="0,0,0,16"/>
     <CheckBox Content="始终置顶" IsChecked="{Binding Topmost}" Margin="0,0,0,12"/>
     <WrapPanel><TextBlock Text="宽度" VerticalAlignment="Center"/><TextBox x:Name="NoteWidth" Text="{Binding Width, StringFormat=0, UpdateSourceTrigger=LostFocus}" PreviewTextInput="SizeInput" DataObject.Pasting="PasteSize" LostKeyboardFocus="CommitSize" Width="70" Margin="8,0,16,8" Padding="6"/>
      <TextBlock Text="高度" VerticalAlignment="Center"/><TextBox x:Name="NoteHeight" Text="{Binding Height, StringFormat=0, UpdateSourceTrigger=LostFocus}" PreviewTextInput="SizeInput" DataObject.Pasting="PasteSize" LostKeyboardFocus="CommitSize" Width="70" Margin="8,0,0,8" Padding="6"/></WrapPanel>
     <CheckBox x:Name="ManualResize" Content="允许拖动右下角调整大小" IsChecked="{Binding AllowManualResize}" Margin="0,4,0,12"/>
     <Button Content="重置位置" Click="ResetPosition" HorizontalAlignment="Left"/>
     <TextBlock Text="尺寸以整数保存。聚焦快捷键可切换编辑状态，Esc 也可取消聚焦。" Style="{StaticResource MutedText}" Margin="0,12,0,0"/>
    </StackPanel></Border>
    <Border x:Name="AppearanceCard" Style="{StaticResource Card}" Margin="0,0,0,12">
     <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
      <TextBlock Text="外观" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,14"/>
      <Grid x:Name="AppearanceLayout" Grid.Row="1" SizeChanged="AppearanceSizeChanged">
       <Grid.ColumnDefinitions><ColumnDefinition Width="3*"/><ColumnDefinition Width="2*"/></Grid.ColumnDefinitions>
       <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="0"/></Grid.RowDefinitions>
       <ScrollViewer x:Name="AppearanceScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="0,0,8,0">
         <TextBlock Text="配色预设" FontWeight="SemiBold" Margin="0,0,0,12"/>
         <ItemsControl ItemsSource="{Binding AppearancePresets}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate><DataTemplate><Button Tag="{Binding Value}" Click="ApplyAppearance" Margin="0,0,8,8" Padding="10,7">
           <StackPanel Orientation="Horizontal"><Border Background="{Binding Value.Background}" BorderBrush="{Binding Value.Border}" BorderThickness="2" CornerRadius="3" Width="24" Height="20" Margin="0,0,6,0"><TextBlock Text="Aa" Foreground="{Binding Value.Text}" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><TextBlock Text="{Binding Name}"/></StackPanel>
          </Button></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
         <TextBlock Text="同时应用背景、文字和聚焦边框颜色。" Style="{StaticResource MutedText}" Margin="0,0,0,18"/>
         <StackPanel x:Name="BackgroundSettings">
          <TextBlock Text="背景" FontWeight="SemiBold" Margin="0,0,0,12"/>
          <WrapPanel Margin="0,4,0,8"><TextBlock Text="背景颜色" VerticalAlignment="Center" Margin="0,0,10,0"/>
           <Button x:Name="BackgroundColorSwatch" Tag="background" Click="ChooseColor" Width="30" Height="28" Padding="0" BorderThickness="1" ToolTip="点击选择背景颜色" AutomationProperties.Name="选择背景颜色"/>
          </WrapPanel>
          <controls:ColorPicker x:Name="BackgroundColorPicker" Color="{Binding BackgroundColor, Mode=TwoWay}" ShowHexInput="False" Margin="0,0,0,12"/>
          <Button Content="恢复默认背景" Click="ResetBackground" HorizontalAlignment="Left" Margin="0,0,0,14"/>
          <TextBlock Text="背景透明度"/><Slider Value="{Binding BackgroundOpacity}" Minimum="0.05" Maximum="1" Margin="0,8,0,14" AutomationProperties.Name="浮笺背景透明度"/>
          <TextBlock Text="圆角"/><Slider Value="{Binding Radius}" Minimum="0" Maximum="40" Margin="0,8,0,0" AutomationProperties.Name="浮笺圆角"/>
         </StackPanel>
         <StackPanel x:Name="FontSettings" Margin="0,24,0,0">
          <TextBlock Text="字体" FontWeight="SemiBold" Margin="0,0,0,12"/>
          <ItemsControl ItemsSource="{Binding FontPresets}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
           <ItemsControl.ItemTemplate><DataTemplate><Button Content="{Binding Name}" Tag="{Binding Value}" Click="ApplyFont" Margin="0,0,8,8" Padding="10,7"/></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
          <ComboBox x:Name="FontChoice" ItemsSource="{Binding InstalledFonts}" SelectedItem="{Binding FontFamily, Mode=TwoWay}" IsEditable="False" IsTextSearchEnabled="True" Padding="6" Margin="0,4,0,12" MaxDropDownHeight="280" AutomationProperties.Name="浮笺字体"/>
          <WrapPanel Margin="0,0,0,12"><TextBlock Text="文字颜色" VerticalAlignment="Center"/>
           <Button x:Name="FontColorSwatch" Tag="font" Click="ChooseColor" Width="30" Height="28" Margin="10,0,0,0" Padding="0" BorderThickness="1" ToolTip="点击选择文字颜色" AutomationProperties.Name="选择文字颜色"/>
          </WrapPanel>
          <controls:ColorPicker x:Name="FontColorPicker" Color="{Binding FontColor, Mode=TwoWay}" ShowHexInput="False" Margin="0,0,0,12"/>
          <WrapPanel Margin="0,0,0,14"><CheckBox Content="粗体" IsChecked="{Binding FontBold}" VerticalAlignment="Center" Margin="0,0,12,0"/>
           <Button Content="恢复默认字体" Click="ResetFont"/></WrapPanel>
          <TextBlock Text="字号（10–72）"/><Slider Value="{Binding FontSize}" Minimum="10" Maximum="72" TickFrequency="1" IsSnapToTickEnabled="True" Margin="0,8,0,14" AutomationProperties.Name="浮笺字号"/>
          <TextBlock Text="文字透明度"/><Slider Value="{Binding FontOpacity}" Minimum="0.1" Maximum="1" Margin="0,8,0,0" AutomationProperties.Name="浮笺文字透明度"/>
         </StackPanel>
         <StackPanel Margin="0,24,0,0">
          <TextBlock Text="聚焦外观" FontWeight="SemiBold" Margin="0,0,0,12"/>
          <WrapPanel Margin="0,0,0,8"><TextBlock Text="边框颜色" VerticalAlignment="Center" Margin="0,0,10,0"/>
           <Button x:Name="FocusColorSwatch" Tag="focus" Click="ChooseColor" Width="30" Height="28" Padding="0" BorderThickness="1" ToolTip="点击选择聚焦边框颜色" AutomationProperties.Name="选择聚焦边框颜色"/>
          </WrapPanel>
          <controls:ColorPicker x:Name="FocusColorPicker" Color="{Binding FocusBorderColor, Mode=TwoWay}" ShowHexInput="False" Margin="0,0,0,12"/>
          <CheckBox Content="聚焦时完全不透明" IsChecked="{Binding OpaqueWhenFocused}" Margin="0,0,0,12"/>
          <TextBlock Text="失焦后边框消失，并使用设置的透明度。" Style="{StaticResource MutedText}"/>
         </StackPanel>
        </StackPanel>
       </ScrollViewer>
       <Grid x:Name="PreviewPanel" Grid.Column="1" Margin="18,0,0,0" VerticalAlignment="Top">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <CheckBox x:Name="PreviewFocused" Content="聚焦效果预览" IsChecked="True" Checked="PreviewFocusChanged" Unchecked="PreviewFocusChanged" Margin="0,0,0,12"/>
        <Border x:Name="AppearancePreview" Grid.Row="1" Padding="12,4,12,4" BorderThickness="2" ClipToBounds="True">
         <Grid><Grid.RowDefinitions><RowDefinition Height="26"/><RowDefinition Height="*"/><RowDefinition Height="28"/></Grid.RowDefinitions>
          <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
           <TextBlock x:Name="PreviewText" Text="待办&#xA;&#xA;买菜&#xA;整理书桌&#xA;读书 30 分钟" TextWrapping="Wrap"/>
          </ScrollViewer>
          <TextBlock x:Name="PreviewHide" Grid.Row="2" Text="—" Width="28" HorizontalAlignment="Left" VerticalAlignment="Center" TextAlignment="Center" FontSize="16"/>
          <TextBlock x:Name="PreviewResize" Grid.Row="2" Text="◢" Width="28" HorizontalAlignment="Right" VerticalAlignment="Center" TextAlignment="Center" FontSize="12"/>
         </Grid>
        </Border>
       </Grid>
      </Grid>
     </Grid>
    </Border>
    <Border Style="{StaticResource Card}" Margin="0,0,0,12"><StackPanel>
     <TextBlock Text="数据管理" FontWeight="SemiBold" Margin="0,0,0,12"/>
     <WrapPanel><Button Content="立即保存" Click="SaveNow" Margin="0,0,8,8"/><Button Content="导出文本" Click="ExportText" Margin="0,0,8,8"/>
      <Button Content="打开数据目录" Click="OpenDirectory" Margin="0,0,8,8"/><Button Content="恢复全部默认设置" Click="ResetSettings" Margin="0,0,8,8"/></WrapPanel>
     <TextBlock Text="笔记保存在本机，恢复设置不会清空正文。" Style="{StaticResource MutedText}"/>
     <TextBlock Text="{Binding Notice}" Foreground="{DynamicResource AccentBrush}" TextWrapping="Wrap" Margin="0,12,0,0"/>
    </StackPanel></Border>
   </StackPanel>
  </ScrollViewer>
 </Grid>
</UserControl>
