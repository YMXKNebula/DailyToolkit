<Window x:Class="DailyUSE.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DailyUSE" Width="1040" Height="760" MinWidth="680" MinHeight="540"
        FontFamily="Microsoft YaHei UI" Foreground="{DynamicResource TextBrush}" Background="{DynamicResource WindowBrush}"
        WindowStartupLocation="CenterScreen">
  <Grid x:Name="RootContent" Background="{DynamicResource WindowBrush}">
    <Grid.ColumnDefinitions><ColumnDefinition Width="182" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
    <Border Grid.Column="0" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,0">
      <DockPanel Margin="18,26,18,20">
        <StackPanel DockPanel.Dock="Top" Margin="10,0,0,30">
          <StackPanel Orientation="Horizontal">
            <Border Width="30" Height="30" CornerRadius="8" Background="{DynamicResource AccentBrush}">
              <TextBlock Text="D" FontSize="19" FontWeight="SemiBold" Foreground="{DynamicResource AccentForegroundBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <TextBlock Text="DailyUSE" Margin="10,0,0,0" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center" />
          </StackPanel>
          <TextBlock Text="日常用的小工具" Style="{StaticResource MutedText}" Margin="0,13,0,0" />
        </StackPanel>
        <StackPanel DockPanel.Dock="Bottom" Margin="12,0,0,0">
          <TextBlock Text="本机运行" Style="{StaticResource MutedText}" />
          <TextBlock Margin="0,8,0,0" FontSize="11">
            <Hyperlink NavigateUri="https://github.com/YMXKNebula/DailyUSE" RequestNavigate="OpenRepository" Foreground="{DynamicResource MutedBrush}">DailyUSE 0.1.0</Hyperlink>
          </TextBlock>
        </StackPanel>
        <StackPanel>
          <RadioButton Content="首页" GroupName="Navigation" Style="{StaticResource NavButton}"
                       IsChecked="{Binding IsHome, Mode=OneWay}" Command="{Binding NavigateCommand}" CommandParameter="home" />
          <RadioButton Content="工具" GroupName="Navigation" Style="{StaticResource NavButton}"
                       IsChecked="{Binding IsTools, Mode=OneWay}" Command="{Binding NavigateCommand}" CommandParameter="tools" />
          <RadioButton Content="电脑信息" GroupName="Navigation" Style="{StaticResource NavButton}"
                       IsChecked="{Binding IsComputer, Mode=OneWay}" Command="{Binding NavigateCommand}" CommandParameter="computer" />
        </StackPanel>
      </DockPanel>
    </Border>
    <Grid Grid.Column="1" Margin="{Binding ContentPadding}">
      <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
      <Grid Margin="0,0,0,25">
        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
        <StackPanel Margin="0,0,14,0">
          <TextBlock Text="{Binding PageTitle}" FontSize="26" FontWeight="SemiBold" />
          <TextBlock Text="{Binding PageDescription}" Style="{StaticResource MutedText}" Margin="0,9,0,0" />
        </StackPanel>
        <Button Grid.Column="1" Content="刷新信息" Command="{Binding RefreshCommand}" VerticalAlignment="Top" Margin="0,5,0,0" />
      </Grid>

      <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                    Visibility="{Binding IsHome, Converter={StaticResource VisibleWhen}}">
        <StackPanel Margin="0,0,8,0">
          <Border Background="{DynamicResource AccentSoftBrush}" CornerRadius="10" Padding="18,15" Margin="0,0,0,20">
            <StackPanel>
              <TextBlock Text="{Binding StatusText}" Foreground="{DynamicResource AccentBrush}" FontWeight="SemiBold" />
              <TextBlock Text="{Binding StatusDetail}" Style="{StaticResource MutedText}" Margin="0,6,0,0" />
              <ProgressBar Height="2" Margin="0,12,0,0" IsIndeterminate="True" Foreground="{DynamicResource AccentBrush}"
                           Visibility="{Binding IsRefreshing, Converter={StaticResource VisibleWhen}}" />
            </StackPanel>
          </Border>
          <TextBlock Text="这台电脑" Style="{StaticResource SectionTitle}" />
          <UniformGrid Columns="2" Margin="-6,0,-6,15">
            <Border Style="{StaticResource Card}" Height="{Binding CardHeight}" Margin="6,0,6,12">
              <StackPanel>
                <TextBlock Text="处理器" Style="{StaticResource MutedText}" />
                <TextBlock Text="{Binding CpuName}" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" LineHeight="22" Margin="0,10,0,6" MaxHeight="44" ToolTip="{Binding CpuName}" />
                <TextBlock Text="{Binding CpuDetail}" Style="{StaticResource MutedText}" />
              </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}" Height="{Binding CardHeight}" Margin="6,0,6,12">
              <StackPanel>
                <TextBlock Text="内存" Style="{StaticResource MutedText}" />
                <TextBlock Text="{Binding MemoryTotal}" FontSize="26" FontWeight="SemiBold" Margin="0,8,0,4" />
                <TextBlock Text="{Binding MemoryDetail}" Style="{StaticResource MutedText}" />
              </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}" Height="{Binding CardHeight}" Margin="6,0,6,0">
              <StackPanel>
                <TextBlock Text="系统" Style="{StaticResource MutedText}" />
                <TextBlock Text="{Binding SystemName}" FontSize="23" FontWeight="SemiBold" Margin="0,8,0,5" />
                <TextBlock Text="{Binding SystemDetail}" Style="{StaticResource MutedText}" />
              </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}" Height="{Binding CardHeight}" Margin="6,0,6,0">
              <StackPanel>
                <TextBlock Text="架构与显示" Style="{StaticResource MutedText}" />
                <TextBlock Text="{Binding Architecture}" FontSize="26" FontWeight="SemiBold" Margin="0,8,0,4" />
                <TextBlock Text="{Binding DisplayDetail}" Style="{StaticResource MutedText}" />
              </StackPanel>
            </Border>
          </UniformGrid>
          <Border Style="{StaticResource Card}" Margin="0,0,0,16">
            <StackPanel>
              <TextBlock Text="运行安排" Style="{StaticResource SectionTitle}" />
              <WrapPanel Margin="0,0,0,10">
                <TextBlock Text="{Binding TaskLimitText}" Margin="0,0,22,0" />
                <TextBlock Text="{Binding LayoutText}" Margin="0,0,22,0" />
                <TextBlock Text="{Binding PowerText}" />
              </WrapPanel>
              <TextBlock Text="{Binding ProfileNote}" Style="{StaticResource MutedText}" />
            </StackPanel>
          </Border>
          <Border Background="{DynamicResource WarningBrush}" CornerRadius="8" Padding="14" Margin="0,0,0,14"
                  Visibility="{Binding HasIssues, Converter={StaticResource VisibleWhen}}">
            <TextBlock Text="{Binding IssueSummary}" TextWrapping="Wrap" Foreground="{DynamicResource WarningTextBrush}" FontSize="12" />
          </Border>
        </StackPanel>
      </ScrollViewer>

      <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                    Visibility="{Binding IsTools, Converter={StaticResource VisibleWhen}}">
        <StackPanel Margin="0,0,8,0">
          <Border Style="{StaticResource Card}">
            <Grid>
              <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
              <StackPanel Margin="0,0,20,0">
                <TextBlock Text="电脑信息" FontSize="18" FontWeight="SemiBold" />
                <TextBlock Text="查看系统、硬件、已安装软件和运行环境。" Style="{StaticResource MutedText}" Margin="0,9,0,0" />
              </StackPanel>
              <Button Grid.Column="1" Content="打开" Command="{Binding OpenComputerCommand}" Style="{StaticResource AccentButton}" VerticalAlignment="Center" />
            </Grid>
          </Border>
          <TextBlock Text="后面写好的工具会放在这里。" Style="{StaticResource MutedText}" Margin="2,20,0,0" />
        </StackPanel>
      </ScrollViewer>

      <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                    Visibility="{Binding IsComputer, Converter={StaticResource VisibleWhen}}">
        <StackPanel Margin="0,0,8,0">
          <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
            <Button Content="保存报告" Click="SaveReport" Margin="0,0,10,0" />
            <Button Content="复制摘要" Click="CopySummary" />
          </StackPanel>
          <TextBlock Text="信息保留在本机。保存报告时，会包含软件名称和硬件配置。" Style="{StaticResource MutedText}" Margin="0,0,0,16" />
          <Border Style="{StaticResource Card}" Margin="0,0,0,16">
            <StackPanel>
              <TextBlock Text="系统与硬件" Style="{StaticResource SectionTitle}" />
              <ItemsControl ItemsSource="{Binding SystemRows}" ItemTemplate="{StaticResource InformationRow}" />
              <ItemsControl ItemsSource="{Binding GraphicsRows}" ItemTemplate="{StaticResource InformationRow}" />
              <ItemsControl ItemsSource="{Binding VolumeRows}" ItemTemplate="{StaticResource InformationRow}" />
            </StackPanel>
          </Border>
          <Border Style="{StaticResource Card}" Margin="0,0,0,16">
            <StackPanel>
              <TextBlock Text="运行环境" Style="{StaticResource SectionTitle}" />
              <DataGrid ItemsSource="{Binding RuntimeRows}" SelectionMode="Single" MaxHeight="200">
                <DataGrid.Columns>
                  <DataGridTextColumn Header="环境" Binding="{Binding Name}" Width="*" />
                  <DataGridTextColumn Header="版本" Binding="{Binding Version}" Width="110" />
                  <DataGridTextColumn Header="状态" Binding="{Binding Status}" Width="80" />
                </DataGrid.Columns>
              </DataGrid>
            </StackPanel>
          </Border>
          <Border Style="{StaticResource Card}" Margin="0,0,0,16">
            <Expander Header="{Binding SoftwareHeader}" IsExpanded="False" Foreground="{DynamicResource TextBrush}">
              <StackPanel Margin="0,16,0,0">
                <TextBlock Text="来自系统安装记录，便携软件可能不会显示。" Style="{StaticResource MutedText}" Margin="0,0,0,12" />
                <TextBox Text="{Binding SoftwareSearch, UpdateSourceTrigger=PropertyChanged}" Padding="10,8" Margin="0,0,0,12"
                         Background="{DynamicResource SurfaceBrush}" Foreground="{DynamicResource TextBrush}" BorderBrush="{DynamicResource BorderBrush}"
                         ToolTip="输入软件名称、版本或发布者筛选" AutomationProperties.Name="筛选已安装软件" />
                <DataGrid ItemsSource="{Binding SoftwareView}" Height="260" SelectionMode="Single">
                  <DataGrid.Columns>
                    <DataGridTextColumn Header="软件" Binding="{Binding Name}" Width="*" />
                    <DataGridTextColumn Header="版本" Binding="{Binding Version}" Width="100" />
                    <DataGridTextColumn Header="发布者" Binding="{Binding Publisher}" Width="130" />
                  </DataGrid.Columns>
                </DataGrid>
              </StackPanel>
            </Expander>
          </Border>
          <Border Background="{DynamicResource WarningBrush}" CornerRadius="8" Padding="14"
                  Visibility="{Binding HasIssues, Converter={StaticResource VisibleWhen}}">
            <TextBlock Text="{Binding IssueSummary}" TextWrapping="Wrap" Foreground="{DynamicResource WarningTextBrush}" FontSize="12" />
          </Border>
        </StackPanel>
      </ScrollViewer>

      <StackPanel Grid.Row="2" Margin="0,18,0,0">
        <TextBlock Text="{Binding Notice}" Foreground="{DynamicResource AccentBrush}" FontSize="12" Margin="0,0,0,8"
                   Visibility="{Binding HasNotice, Converter={StaticResource VisibleWhen}}" />
        <Grid>
          <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
          <TextBlock Text="{Binding StatusText}" Style="{StaticResource MutedText}" />
          <TextBlock Grid.Column="1" Text="{Binding StartupText}" Style="{StaticResource MutedText}" Margin="12,0,0,0" />
        </Grid>
      </StackPanel>
    </Grid>
  </Grid>
</Window>
